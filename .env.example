# Copie ce fichier en .env puis remplis les valeurs
PORT=3000
# Origines autorisées (ex: Live Server), séparées par des virgules
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Email de réception des messages
CONTACT_TO=contact@ton-domaine.com

# SMTP (laisse SMTP_HOST vide pour enregistrer seulement dans data/messages.jsonl)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASS=mot_de_passe_application
